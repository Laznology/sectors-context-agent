# OpenAI-compatible AI gateway
AI_GATEWAY_URL=
AI_GATEWAY_API_KEY=
AI_MODEL_PLANNER=
AI_MODEL_SYNTHESIZER=

# Sectors REST API v2 and MCP
SECTORS_API_KEY=
SECTORS_BASE_URL=https://api.sectors.app/v2
SECTORS_MCP_URL=https://sectors-mcp.supertype.ai/mcp

# PostgreSQL — start with: docker compose up -d
# Kalau di mesinmu sudah ada Postgres di 5432, naikkan POSTGRES_PORT (mis. 5433)
# dan samakan port-nya di DATABASE_URL.
POSTGRES_PORT=5432
DATABASE_URL=postgres://sectors:sectors@localhost:5432/sectors

# Hono API server
PORT=3001

# Better Auth — generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32

# Local development seed user (optional overrides)
SEED_USER_NAME=Demo User
SEED_USER_EMAIL=demo@example.com
SEED_USER_PASSWORD=demo-password-123
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5173
